{
  "name": "siciju",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
  // Uncomment after creating your D1 database in Cloudflare Dashboard -> Storage & Databases -> D1 SQL Database:
  ,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siciju-leaderboard",
      "database_id": "ffde2abf-9962-47d9-a115-4c91e3765f06"
    }
  ]
}
